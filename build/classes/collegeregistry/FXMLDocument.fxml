            <ImageView fitHeight="88.0" fitWidth="150.0" layoutX="89.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/logo-removebg-preview.png" />
               </image>
            </ImageView>
            <Text fill="#fff6f6" layoutX="194.0" layoutY="57.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Wakanda University">
               <font>
                  <Font name="System Bold Italic" size="36.0" />
               </font>
            </Text>
         </children>
      </AnchorPane>
