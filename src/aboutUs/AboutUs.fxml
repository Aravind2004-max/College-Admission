<AnchorPane id="AnchorPane" prefHeight="1080.0" prefWidth="1899.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="aboutUs.AboutUsController">
   <children>
      <ImageView fitHeight="1080.0" fitWidth="1933.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/ab.jpg" />
         </image>
      </ImageView>
      <AnchorPane fx:id="glassPane" layoutX="411.0" layoutY="91.0" prefHeight="794.0" prefWidth="1098.0" styleClass="glass-pane" stylesheets="@../css/InnerAnchorPane.css">
         <children>
            <Text layoutX="431.0" layoutY="142.0" strokeType="OUTSIDE" strokeWidth="0.0" text="About Us">
               <font>
                  <Font name="System Bold" size="48.0" />
               </font></Text>
            <Label layoutX="26.0" layoutY="129.0" prefHeight="579.0" prefWidth="1019.0" text="Wakanda University is a center of excellence dedicated to shaping the leaders of tomorrow. With a commitment to academic innovation, world-class faculty, and state-of-the-art infrastructure, we empower students to unlock their full potential. Our university fosters a culture of integrity, inclusivity, and lifelong learning — preparing graduates not just for jobs, but for meaningful impact in the world. At Wakanda, education goes beyond the classroom — it’s a journey of transformation, vision, and values." textFill="WHITE" wrapText="true">
               <font>
                  <Font name="System Bold" size="36.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
      <Button fx:id="backBtn" layoutX="1355.0" layoutY="44.0" mnemonicParsing="false" onAction="#backToHome" styleClass="back" stylesheets="@../css/BackBtn.css" text="Back" />
   </children>
</AnchorPane>
